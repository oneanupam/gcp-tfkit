# Resource block to create Snapshot Schedule Policy for Disk
resource "google_compute_resource_policy" "dev_disk_snapshot_schedule_policy" {
  project = var.project_id

  name   = "dev-snapshot-schedule-policy"
  region = var.resource_region

  snapshot_schedule_policy {
    schedule {
      daily_schedule {
        days_in_cycle = 1
        start_time    = "04:00"
      }
    }
    retention_policy {
      max_retention_days    = 7
      on_source_disk_delete = "KEEP_AUTO_SNAPSHOTS"
    }
    snapshot_properties {
      storage_locations = ["${var.resource_region}"]
    }
  }
}

# Resource block to associate existing resource policie to a zonal disk.
resource "google_compute_disk_resource_policy_attachment" "dev_disk_snapshot_schedule_policy_attachment" {
  project = var.project_id

  name = google_compute_resource_policy.dev_disk_snapshot_schedule_policy.name
  disk = google_compute_disk.dev_vm01_data_pd01.name
  zone = var.resource_zone
}
